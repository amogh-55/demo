# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Transactions require a replica set, which
# every Atlas cluster provides. Never expose this to the browser.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=turf_booking

# Connections ONE server instance may hold open. Default 40, which suits a single
# long-running server: holds and bookings run in transactions that keep a
# connection for their whole duration, and a small pool makes customers queue.
#
# SET THIS ON A SERVERLESS DEPLOY. Vercel runs many instances at once and each
# one opens its own pool, so the real number is 40 x however many are warm. An
# Atlas M0/M2/M5 cluster allows 500 connections in total, which 13 warm instances
# would reach on the default; Atlas then refuses new ones and the site starts
# failing under exactly the load that caused it.
#
# 10 is a sensible value on Vercel: roughly 50 instances before the cap.
MONGODB_POOL_SIZE=10

# ─── Admin authentication ────────────────────────────────────────────────────
# Random string, 32+ characters. Signs the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_AUTH_SECRET=

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=Cricket Turf Arena

# ─── Business defaults (first run only; edit later in Admin → Settings) ───────
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
UPI_ID=
UPI_PAYEE_NAME=
UPI_QR_IMAGE_URL=

# ─── Payment screenshot storage ───────────────────────────────────────────────
# LEAVE BLANK FOR LOCAL DEVELOPMENT. With no bucket configured, screenshots are
# written to ./.storage (gitignored, outside public/) and streamed back only
# through the admin-authenticated route. That is fine for testing but does NOT
# survive a serverless deploy, where the filesystem is ephemeral and per-instance.
#
# For production set these to a PRIVATE S3-compatible bucket (Cloudflare R2,
# Supabase Storage, MinIO, AWS S3). Screenshots are then served through a signed
# URL the admin API mints after checking the session.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=turf-payment-screenshots
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Authenticates the nightly screenshot-retention cron (vercel.json). Vercel sends
# this as "Authorization: Bearer <value>" on every cron invocation. REQUIRED in
# production: with it unset the route refuses to run at all, because a public URL
# that deletes files should not be reachable without a secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ─── SMS: mobile verification and new-booking alerts ─────────────────────────
# OPTIONAL. Leave blank and no text message is ever sent: the OTP and alert
# switches in Admin → Settings simply have nothing to send with, and the settings
# screen says so rather than pretending messages went out.
#
# Every message costs money on the client's own provider account, which is why
# both switches start OFF and neither is turned on by a deploy.
#
# Pick ONE provider. MSG91 is the usual choice in India; Twilio works anywhere.
#   SMS_PROVIDER=msg91  -> MSG91_AUTH_KEY, MSG91_SENDER_ID, MSG91_ROUTE (default 4)
#   SMS_PROVIDER=twilio -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER
#
# SMS_PROVIDER covers booking alerts. Mobile verification is separate — see the
# MSG91 OTP Widget block below, which does not use SMS_PROVIDER at all.
#
# Leaving SMS_PROVIDER unset logs the message instead of sending it. Outside
# production a one-time code from the built-in OTP path is printed in that log
# line; in production only the number is, so a live log never carries a live code.
SMS_PROVIDER=msg91
MSG91_SENDER_ID=
MSG91_ROUTE=4
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── MSG91 OTP Widget: mobile verification ───────────────────────────────────
# With all three set, MSG91 sends and checks the one-time code itself. We never
# generate, store or see a code, and the browser's "verified" claim is worth
# nothing until the server spends its access token against MSG91 using the
# AuthKey below.
#
# MSG91_AUTH_KEY      SECRET. Server only. Never NEXT_PUBLIC_, never logged.
#                     The one value that makes a verification mean anything.
# MSG91_WIDGET_ID     Not a secret. The widget cannot run without it in the page.
# MSG91_WIDGET_TOKEN  Not a secret either — MSG91's client-side widget token.
#
# The two widget values are still read server-side and passed to the one
# component that needs them, so they appear only on pages that verify a number
# and a rotation is a restart rather than a rebuild.
#
# Leave MSG91_WIDGET_ID/MSG91_WIDGET_TOKEN blank and the widget is simply not
# offered; the built-in OTP path above is what runs instead.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# Set to 1 to expose /otp-test on a deployed site. Leave blank: every send there
# spends real SMS balance. The page is always available in local development.
OTP_TEST_PAGE=

# ─── Script-only variables (not read by the running app) ──────────────────────
# These are passed inline when running a script, not stored in this file:
#
#   ADMIN_USERNAME=owner ADMIN_PASSWORD='...' npm run create-admin
#     Creates or updates an admin login. ADMIN_DISPLAY_NAME is optional.
#     The account lives in MongoDB, so a password change takes effect on the
#     deployed site immediately — no redeploy needed.
#
#   SEED_ALLOW_PRODUCTION=1 npm run seed
#     Safety latch on the seeder. Never set this against a live database.
#
#   CONFIRM_RESET=yes npm run reset-bookings
#     DESTRUCTIVE. Deletes every booking, reserved slot and block, and removes the
#     pre-facility grounds, so `npm run seed` can lay down the new
#     Location -> Facility -> Resource structure. Run once, before any real
#     customer has paid for anything. Admin accounts and settings are kept.
